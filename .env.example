# ---- Everyone ----
# The code Loops House assigned when you enrolled (celo_...). Every transaction carries it.
ATTRIBUTION_CODE=
# Celo mainnet RPC. The public one works; a provider such as Chainstack is steadier.
CELO_RPC_URL=https://forno.celo.org

# ---- Agent ----
# Optional Textile partner API key. Leave empty: the paying wallet signs a proof instead.
TEXTILE_API_KEY=
# Optional: lets the agent read plain-text invoices. Only redacted text is ever sent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Hard stop: most one invoice may cost the client, in USD₮.
MAX_INVOICE_USDT=500
# USD₮ sent with each private payout so the freelancer can pay gas when moving it.
GAS_TOP_UP_USDT=0.05
# Optional ERC-5564 announcer on Celo. Leave empty: the receipt carries what the freelancer needs.
STEALTH_ANNOUNCER_ADDRESS=

# ---- Website (npm run app) ----
# Optional: the first name the website greets you with.
CLIENT_NAME=
# Optional: the port the website runs on.
NAIRA_REACH_PORT=8787

# ---- Client (only on the client's own device) ----
# The client's key for their Altana wallet. It signs setup, grant and revoke. Never given to the agent.
CLIENT_ADMIN_PRIVATE_KEY=

# ---- Optional, --direct only. Empty: --direct sends from the client wallet above (same address). ----
DIRECT_WALLET_PRIVATE_KEY=
